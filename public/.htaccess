Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Pas de RewriteBase : Apache la déduit du dossier. Ces règles
    # fonctionnent donc que public/ soit la racine du site ou un
    # sous-dossier atteint via le .htaccess du niveau au-dessus.

    # Ne jamais réécrire les fichiers et dossiers réellement présents
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Flux
    RewriteRule ^rss\.xml$ rss.php [L]

    # Article : /a/mon-article
    RewriteRule ^a/([a-z0-9-]+)/?$ article.php?slug=$1 [L,QSA]

    # Étiquette : /t/agents
    RewriteRule ^t/([^/]+)/?$ tag.php?tag=$1 [L,QSA]

    # Laboratoire : /labo/anthropic
    RewriteRule ^labo/([a-z0-9_-]+)/?$ index.php?labo=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
</IfModule>

# Le contenu et le moteur ne doivent jamais être servis directement.
<FilesMatch "\.(json|md|sh|yml)$">
    Require all denied
</FilesMatch>
